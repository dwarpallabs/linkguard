<?xml version="1.0" encoding="utf-8"?>
<!--
    Backup and device-transfer rules for Android 12+ (Android 8–11 uses backup_rules.xml).
    Only user settings leave the phone. Never the reporter secret (it must not leave the phone),
    never the "Was that link a scam?" question (it names a website the user opened), and never
    the allowlist cache (it is downloaded again).
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="reporter.xml" />
        <exclude domain="sharedpref" path="after_open.xml" />
        <exclude domain="file" path="allowlist.txt" />
        <exclude domain="file" path="allowlist.sig" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="reporter.xml" />
        <exclude domain="sharedpref" path="after_open.xml" />
        <exclude domain="file" path="allowlist.txt" />
        <exclude domain="file" path="allowlist.sig" />
    </device-transfer>
</data-extraction-rules>
