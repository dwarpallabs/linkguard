<?xml version="1.0" encoding="utf-8"?>
<!--
    Auto Backup rules for Android 8–11 (Android 12+ uses data_extraction_rules.xml).
    Only user settings are backed up. Never the reporter secret (it must not leave the phone)
    and never the allowlist cache (it is downloaded again).
-->
<full-backup-content>
    <exclude domain="sharedpref" path="reporter.xml" />
    <exclude domain="file" path="allowlist.txt" />
    <exclude domain="file" path="allowlist.sig" />
</full-backup-content>
