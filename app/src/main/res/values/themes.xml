<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.Linkguard" parent="android:Theme.Material.Light.NoActionBar" />

    <!-- Invisible while forwarding: no background, no dim, no window animation. The system bars are
         made transparent by enableEdgeToEdge() in the activity, not here: statusBarColor and
         navigationBarColor are deprecated from Android 15 (Play flags them). -->
    <style name="Theme.Linkguard.Intercept">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:backgroundDimEnabled">false</item>
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:windowContentOverlay">@null</item>
    </style>
</resources>
