<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
        Network is used only for: shortener redirect lookups, RDAP registration
        dates (domain only) and, later, hash-prefix reputation lookups and feed updates.
    -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Android 11+ package visibility: lets us list installed browsers to forward to. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="https" />
        </intent>
        <!-- Lets LinkGuard ask which app is the SMS app (roadmap B1); it never reads messages. -->
        <intent>
            <action android:name="android.intent.action.SENDTO" />
            <data android:scheme="smsto" />
        </intent>
        <!-- Which installed browsers support Custom Tabs, to forward a Custom Tab as one. -->

        <intent>
            <action android:name="android.support.customtabs.action.CustomTabsService" />
        </intent>
    </queries>


    <application
        android:name=".LinkGuardApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Linkguard">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Linkguard"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            RISK: this intent filter is what makes Android treat LinkGuard as a browser
            (ROLE_BROWSER). It must stay host-less http/https with DEFAULT + BROWSABLE.
            Own empty task, never in recents, translucent so a silent forward is invisible.
        -->
        <activity
            android:name=".LinkInterceptActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@style/Theme.Linkguard.Intercept">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data android:scheme="http" />
                <data android:scheme="https" />
            </intent-filter>
        </activity>

        <!--
            "Look without opening" (roadmap B5): the only place LinkGuard shows a page, on tap, for one
            minute, in its own process with its own WebView data folder. Not exported.
        -->
        <activity
            android:name=".SafeViewActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:process=":safeview"
            android:theme="@style/Theme.Linkguard" />

        <!-- WebView Safe Browsing would send page URLs to Google: off (the foss build has no Google parts either). -->
        <meta-data
            android:name="android.webkit.WebView.EnableSafeBrowsing"
            android:value="false" />

        <!-- Managed configuration for organisations (roadmap C5): lists and forced-on checks, read by ManagedConfig. -->
        <meta-data
            android:name="android.content.APP_RESTRICTIONS"
            android:resource="@xml/app_restrictions" />

        <!--
            RISK (default-browser flow): advertises Custom Tabs support
, so apps that open links in a
            Custom Tab of the default browser (Google Messages, Gmail, ...) send them to LinkGuard
            instead of going straight to Chrome. The launch still arrives at LinkInterceptActivity's
            VIEW filter above; the service itself does nothing (see LinkGuardCustomTabsService).
        -->
        <service
            android:name=".browser.LinkGuardCustomTabsService"
            android:exported="true">
            <intent-filter>
                <action android:name="android.support.customtabs.action.CustomTabsService" />
            </intent-filter>
        </service>

        <!--
            "Check with LinkGuard" in the share sheet.
 A separate ACTION_SEND target: it does not
            change the VIEW filter above or the default-browser role. Every share opens in a new,
            hidden task (documentLaunchMode="always"), so a second share can never be dropped in
            favour of an older message restored from a task the system killed. Close or Back
            returns to the app the message was shared from.
        -->
        <activity
            android:name=".ShareCheckActivity"
            android:autoRemoveFromRecents="true"
            android:documentLaunchMode="always"
            android:excludeFromRecents="true"
            android:exported="true"
            android:label="@string/share_target_label"
            android:theme="@style/Theme.Linkguard">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />

                <category android:name="android.intent.category.DEFAULT" />

                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>
    </application>


</manifest>
